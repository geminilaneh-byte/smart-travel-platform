<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg" android:fillViewport="true"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="💊 دستیار مصرف دارو" android:textColor="@color/text" android:textSize="24sp" android:textStyle="bold" android:gravity="right"/><TextView android:id="@+id/profileSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="پروفایل: ثبت نشده" android:textColor="@color/muted" android:textSize="16sp" android:gravity="right" android:padding="8dp"/><Button android:id="@+id/profileButton" android:layout_width="match_parent" android:layout_height="48dp" android:text="👤 پروفایل و دسترس‌پذیری"/><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:background="@color/card"><EditText android:id="@+id/name" android:layout_width="match_parent" android:layout_height="48dp" android:hint="نام دارو" android:textColor="@color/text" android:textColorHint="@color/muted"/><EditText android:id="@+id/dose" android:layout_width="match_parent" android:layout_height="48dp" android:hint="دوز و دستور پزشک" android:textColor="@color/text" android:textColorHint="@color/muted"/><EditText android:id="@+id/prescriber" android:layout_width="match_parent" android:layout_height="48dp" android:hint="نام پزشک / تجویزکننده" android:textColor="@color/text" android:textColorHint="@color/muted"/><EditText android:id="@+id/indication" android:layout_width="match_parent" android:layout_height="48dp" android:hint="علت مصرف ثبت‌شده برای شما" android:textColor="@color/text" android:textColorHint="@color/muted"/><Spinner android:id="@+id/mealRelation" android:layout_width="match_parent" android:layout_height="48dp"/><Button android:id="@+id/timeButton" android:layout_width="match_parent" android:layout_height="48dp" android:text="انتخاب ساعت"/><EditText android:id="@+id/stock" android:layout_width="match_parent" android:layout_height="48dp" android:hint="تعداد موجودی" android:textColor="@color/text" android:textColorHint="@color/muted" android:inputType="number"/><EditText android:id="@+id/unitsPerDose" android:layout_width="match_parent" android:layout_height="48dp" android:hint="تعداد مصرف در هر نوبت (مثلاً 1 یا 0.5)" android:textColor="@color/text" android:textColorHint="@color/muted" android:inputType="numberDecimal"/><EditText android:id="@+id/refillLeadDays" android:layout_width="match_parent" android:layout_height="48dp" android:hint="چند روز قبل از اتمام یادآوری شود؟ (پیش‌فرض 5)" android:textColor="@color/text" android:textColorHint="@color/muted" android:inputType="number"/><ImageView android:id="@+id/photoPreview" android:layout_width="match_parent" android:layout_height="180dp" android:layout_marginTop="10dp" android:background="#0f172a" android:contentDescription="عکس دارو" android:scaleType="centerCrop" android:visibility="gone"/><Button android:id="@+id/photoButton" android:layout_width="match_parent" android:layout_height="48dp" android:text="📷 انتخاب عکس دارو"/><Button android:id="@+id/removePhoto" android:layout_width="match_parent" android:layout_height="48dp" android:text="حذف عکس انتخاب‌شده" android:visibility="gone"/><Button android:id="@+id/save" android:layout_width="match_parent" android:layout_height="48dp" android:text="ذخیره دارو"/><Button android:id="@+id/exactSettings" android:layout_width="match_parent" android:layout_height="48dp" android:text="فعال‌کردن آلارم دقیق"/></LinearLayout><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="داروهای من" android:textColor="@color/text" android:textSize="20sp" android:textStyle="bold" android:gravity="right" android:layout_marginTop="18dp"/><LinearLayout android:id="@+id/list" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/></LinearLayout></ScrollView>